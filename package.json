		"call",
		"answer",
		"reply",
		"async",
		"await"
	],
	"dependencies": {
		"serialize-error": "^13.0.1"
	},
	"devDependencies": {
		"electron": "^44.4.5",
		"execa": "^10.0.1",
		"tsd": "^0.33.0",
		"xo": "^5.0.1"
	},
	"xo": {
		"ignores": [
			"test/fixture"
		]
